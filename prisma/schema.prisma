// Prisma schema for CivilLearn
// Maps the "Database Structure (High Level Collections)" from the Master
// Blueprint (Part 29.2) onto a relational PostgreSQL model.
//
// Firebase Auth remains the identity provider (see lib/firebase/); the `User`
// model here is a mirror row keyed by the Firebase UID, used for relational
// joins (progress, enrollments, community posts, etc.) that Firestore/Auth
// alone don't do well.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  ENGINEER
  TEACHER
  PROFESSIONAL
  ADMIN
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  displayName String?
  photoURL    String?
  role        UserRole @default(STUDENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  progress       CourseProgress[]
  lessonProgress LessonProgress[]
  labResults     LabResult[]
  toolResults    ToolResult[]
  quizAttempts   QuizAttempt[]
  projects       Project[]
  posts          Post[]
  comments       Comment[]
  aiChats        AiChatSession[]
  files          FileUpload[]
  dailyGoal      DailyGoal?
  activityEvents ActivityEvent[]

  @@map("users")
}

model DailyGoal {
  id            String   @id @default(cuid())
  userId        String   @unique
  targetMinutes Int      @default(30)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_goals")
}

model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String // e.g. "lesson_completed", "quiz_taken", "tool_used"
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_events")
}

// ---------------------------------------------------------------------------
// Subjects & Courses (Learning System — Part 4)
// ---------------------------------------------------------------------------

// The 8 subject areas from the blueprint's Academic Learning section:
// Mathematics, Engineering Science, Basic Civil Engineering, Structural
// Engineering, Geotechnical Engineering, Water & Environmental,
// Transportation Engineering, Construction Engineering.
model Subject {
  id            String  @id @default(cuid())
  slug          String  @unique
  title         String
  titleBn       String?
  description   String?
  descriptionBn String?
  order         Int     @default(0)

  courses Course[]

  @@map("subjects")
}

model Course {
  id            String  @id @default(cuid())
  subjectId     String
  slug          String  @unique
  title         String
  titleBn       String?
  description   String?
  descriptionBn String?
  order         Int     @default(0)
  published     Boolean @default(false)

  subject  Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  modules  Module[]
  progress CourseProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@map("courses")
}

model Module {
  id       String @id @default(cuid())
  courseId String
  title    String
  titleBn  String?
  order    Int    @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id             String  @id @default(cuid())
  moduleId       String
  title          String
  titleBn        String?
  contentType    String // "video" | "interactive" | "reading" | "lab"
  contentUrl     String?
  body           String? // markdown body for "reading" type lessons; null for others
  bodyBn         String? // Bengali markdown body; null falls back to English body with a notice
  interactiveKey String? // registry key for "interactive" lessons — see components/visualizations/registry.tsx
  labKey         String? // registry key for "lab" lessons — see components/labs/registry.tsx
  durationMin    Int?    @default(10)
  order          Int     @default(0)

  module     Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  labResults LabResult[]

  @@index([moduleId])
  @@map("lessons")
}


model CourseProgress {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  percentComplete Int     @default(0)
  lastLessonId   String?
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_progress")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

// A submitted virtual-lab run — the raw inputs the student entered (or
// accepted from the pre-filled sample data) plus the computed results, so
// the "Auto Lab Report" persists across visits instead of being lost on
// refresh. One lesson can have many results per user (re-running a lab
// with different inputs is expected practice, not an error case).
model LabResult {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  inputData Json // raw form inputs, shape depends on labKey
  results   Json // computed outputs, shape depends on labKey
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@map("lab_results")
}

// Engineering Tools (Part 12) results — deliberately NOT tied to a Lesson,
// since tools are standalone utilities defined in a static registry
// (components/tools/registry.tsx), not database-backed content the way
// courses and lessons are. toolSlug is a plain string, not a foreign key,
// for the same reason labKey/interactiveKey on Lesson are plain strings:
// the thing it references lives in code, not a database table.
model ToolResult {
  id        String   @id @default(cuid())
  userId    String
  toolSlug  String
  inputData Json // raw form inputs, shape depends on toolSlug
  results   Json // computed outputs, shape depends on toolSlug
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, toolSlug])
  @@map("tool_results")
}

// ---------------------------------------------------------------------------
// Quizzes (Practice & Exam System — Part 14)
// ---------------------------------------------------------------------------

model Quiz {
  id       String @id @default(cuid())
  title    String
  category String
  timedSeconds Int?

  questions Question[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())

  @@map("quizzes")
}

model Question {
  id     String @id @default(cuid())
  quizId String
  type   String // "mcq" | "cq" | "numerical" | "viva"
  prompt String
  choices Json? // for MCQ: array of { id, text }
  answer  Json  // correct answer(s)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("questions")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  answers   Json
  startedAt DateTime @default(now())
  finishedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("quiz_attempts")
}

// ---------------------------------------------------------------------------
// Projects (Real Project Experience — Part 11)
// ---------------------------------------------------------------------------

model Project {
  id          String  @id @default(cuid())
  userId      String?
  title       String
  type        String // "residential" | "commercial" | "bridge" | "road"
  description String?
  isTemplate  Boolean @default(false) // true for platform-provided case studies

  files FileUpload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("projects")
}

// ---------------------------------------------------------------------------
// Community (Part 15)
// ---------------------------------------------------------------------------

model Post {
  id       String  @id @default(cuid())
  authorId String
  title    String
  body     String
  category String // "question" | "discussion" | "project-share"

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

model Comment {
  id       String @id @default(cuid())
  postId   String
  authorId String
  body     String

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// AI Assistant history (Part 13)
// ---------------------------------------------------------------------------

model AiChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("ai_chat_messages")
}

// ---------------------------------------------------------------------------
// File uploads (Resource Library / Storage — Part 16, 28)
// ---------------------------------------------------------------------------

model FileUpload {
  id            String  @id @default(cuid())
  uploaderId    String?
  projectId     String?
  fileName      String
  storagePath   String // path in Firebase Storage
  mimeType      String
  sizeBytes     Int

  uploader User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("file_uploads")
}
