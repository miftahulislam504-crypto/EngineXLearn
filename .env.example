# ---------------------------------------------------------------------------
# Firebase (client — safe to expose to browser, hence NEXT_PUBLIC_ prefix)
# Get these from: Firebase Console > Project Settings > General > Your apps
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin (server-only — NEVER prefix with NEXT_PUBLIC_)
# Get these from: Firebase Console > Project Settings > Service Accounts
#   > Generate new private key
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# PostgreSQL (Prisma)
# Local dev example: postgresql://postgres:postgres@localhost:5432/civillearn
# Hosted options: Neon, Supabase, Railway all give you this connection string
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# OpenAI (AI Engineering Assistant — Part 13 of the blueprint)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
